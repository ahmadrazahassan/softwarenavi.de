# ─────────────────────────────────────────────────────────────────────────────
# Softwarenavi (softwarenavi.de) — environment variables
# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables.
# Never commit real keys. Without Supabase the site falls back to the demo dataset in lib/data.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://softwarenavi.de

# ── Supabase (project region: eu-central-1 / Frankfurt) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# New-style Supabase keys (optional, same project)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json

# ── E-Mail via Resend (https://resend.com) ───────────────────────────────────
# 1. Add softwarenavi.de in Resend → Domains (region: eu-west-1 / Ireland), set the DNS records.
# 2. Create an API key with "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender for double-opt-in + contact mails (must be on the verified domain)
MAIL_FROM=hallo@softwarenavi.de
MAIL_FROM_NAME=Softwarenavi
# Inbox that receives contact-form messages
CONTACT_INBOX=hallo@softwarenavi.de

# ── Security ─────────────────────────────────────────────────────────────────
# Random secret for hashing IPs (affiliate clicks, consent log, rate limits).
# Generate: openssl rand -hex 32   — rotate quarterly
IP_HASH_SALT=

# ── Optional ─────────────────────────────────────────────────────────────────
# Self-hosted Plausible host, loaded only after „Statistik“ consent
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Test/preview only: generated seed reviews. Ignored on Vercel Production.
SEED_REVIEWS=false
